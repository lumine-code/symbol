{
  "lumine-text-editor:not([mini])": {
    "cmdorctrl-r": "symbol:toggle-file-symbols",
    "ctrl-alt-d": "symbol:go-to-definition"
  },
  // `lumine-workspace` rather than `body`, which is the fleet's one spelling for
  // global scope. cmdorctrl-shift-r is a cross-editor convention and stays out
  // of the alt- tier.
  "lumine-workspace": {
    "cmdorctrl-shift-r": "symbol:toggle-project-symbols"
  },
  // A genuine keystroke divergence rather than a cmd/ctrl swap, so it keeps the
  // .platform-* prefix: a package's keymap files are added one at a time with
  // no platform filtering, so keymaps/darwin.json here would load everywhere.
  ".platform-darwin lumine-text-editor:not([mini])": {
    "cmd-alt-down": "symbol:go-to-definition",
    "cmd-alt-up": "symbol:return-from-definition"
  },
  ".platform-win32 lumine-text-editor:not([mini])": {
    "ctrl-alt-shift-down": "symbol:go-to-definition",
    "ctrl-alt-shift-up": "symbol:return-from-definition"
  },
  ".platform-linux lumine-text-editor:not([mini])": {
    "ctrl-alt-shift-down": "symbol:go-to-definition",
    "ctrl-alt-shift-up": "symbol:return-from-definition"
  }
}
