{
  ".symbol .select-list": {
    "alt-enter": "symbol:open-selected-with",
    "ctrl-alt-enter": "symbol:open-selected-external",
    "alt-shift-enter": "symbol:show-selected-in-folder"
  },
  ".symbol .select-list lumine-text-editor[mini]": {
    "alt-enter": "symbol:open-selected-with",
    "ctrl-alt-enter": "symbol:open-selected-external",
    "alt-shift-enter": "symbol:show-selected-in-folder"
  },
  ".symbol-source-selector lumine-text-editor[mini]": {
    "alt-enter": "symbol:use-document-source-for-grammar"
  },
  "lumine-text-editor:not([mini])": {
    "cmdorctrl-r": "symbol:toggle-file-symbols",
    "f12": "symbol:go-to-definition",
    "shift-f12": "symbol:return-from-definition"
  },
  // `lumine-workspace` rather than `body`, which is the fleet's one spelling for
  // global scope. cmdorctrl-shift-r is a cross-editor convention and stays out
  // of the alt- tier.
  "lumine-workspace": {
    "cmdorctrl-shift-r": "symbol:toggle-project-symbols"
  }
}
